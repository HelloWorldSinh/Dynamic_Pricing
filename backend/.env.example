# Database config:
# SQLite (Local test without docker): sqlite:///./dynamic_pricing.db
# PostgreSQL (Production/Docker): postgresql+psycopg2://postgres:postgres@localhost:5432/dynamic_pricing
DATABASE_URL=sqlite:///./dynamic_pricing.db


# App config
PROJECT_NAME="Dynamic Pricing System API"
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBOUNCE_SECONDS=30
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
